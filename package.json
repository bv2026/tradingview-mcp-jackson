{
  "name": "tradingview-mcp",
  "version": "1.0.0",
  "description": "MCP bridge for TradingView Desktop via Chrome DevTools Protocol",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "tv": "src/cli/index.js"
  },
  "exports": {
    ".": "./src/server.js",
    "./core": "./src/core/index.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "tv": "node src/cli/index.js",
    "report:all-strategies": "node scripts/all-strategies-report.mjs reports/all-strategies-decision.md",
    "publish:all-strategies": "node scripts/publish-all-strategies.mjs",
    "build:llm-input": "node scripts/build-all-strategies-llm-input.mjs",
    "hydrate:llm-watch": "node scripts/hydrate-all-strategies-watch.mjs",
    "run:llm-decisions": "node scripts/run-all-strategies-llm.mjs",
    "test": "node --test tests",
    "test:sanity": "node --test tests/sanity.test.js",
    "sync:tool-count": "node scripts/sync-tool-count.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "chrome-remote-interface": "^0.33.2",
    "dotenv": "^17.4.1"
  }
}
